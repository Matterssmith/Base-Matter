      "information": "{{CLASSIC_HEADER}} @InformationTitle\n{{CLASSIC_LINE}} @LabelBot: @Bot\n{{CLASSIC_LINE}} @LabelVersion: @Version\n{{CLASSIC_LINE}} @LabelProject: @Project\n{{CLASSIC_LINE}} @LabelOwner: @Owner\n{{CLASSIC_LINE}} @LabelPrefix: @Prefix\n{{CLASSIC_LINE}} @LabelDate: @Date\n{{CLASSIC_LINE}} @LabelCommands: @Commands\n{{CLASSIC_LINE}} @LabelCategoriesActive: @CategoriesActive\n{{CLASSIC_LINE}} @LabelSubBots: @SubBots\n{{CLASSIC_LINE}} @LabelPremiumBots: @PremiumBots\n{{CLASSIC_LINE}} @LabelURL: @URL\n{{CLASSIC_CLOSE}}\n",
