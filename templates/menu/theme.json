  "matter_templates": {
    "control": "{{CLASSIC_HEADER}} 𝗖𝗼𝗻𝘁𝗿𝗼𝗹\n{{BODY}}\n{{CLASSIC_CLOSE}}\n",
    "legacy-menu": "*꒦꒷✰꒷꒦︶꒦꒷✧꒷꒦︶꒦꒷✰꒷꒦*\n꧁✪⃢.✪ 𝐌𝐚𝐭𝐭𝐞𝐫𝐬𝐬𝐦𝐢𝐭𝐡 ۞₪»̶⟩\n\n*Base-Matter* · ✦\n\n{{CLASSIC_HEADER}} 𝗖𝗼𝗻𝘁𝗿𝗼𝗹\n💬 𝗖𝗼𝗺𝗮𝗻𝗱𝗼𝘀 𝗱𝗲 𝗰𝗼𝗻𝘁𝗿𝗼𝗹\n\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ◉ =/>status — Estado de este chat\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ⓘ =/>status --mod — Configuración del socket [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ⊙ =/>status --global — Predeterminado general [consulta]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ✦ =/>bot on/off — Activar o apagar este chat [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ♧ =/>bot inherit — Restaurar herencia [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ⚙︎ =/>bot --mod on/off — Predeterminado del socket [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ♧ =/>bot group on/off — Grupos [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ♙ =/>bot private on/off — Privados externos [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ☷ =/>bot channel on/off — Canales [requiere identidad verificada]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ♧ =/>bot community on/off — Avisos comunitarios [requiere metadatos]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ♛ =/>set — Configuración [propietario]\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ◈ =/>roles — Vault-Matter [solo lectura]\n{{CLASSIC_ROW}}{{CLASSIC_LAST_BRANCH}}[ ⴵ =/>audit — Auditoría [propietario]\n\n{{CLASSIC_EMBLEM}} =/>status funciona incluso cuando el bot está apagado.\n{{CLASSIC_CLOSE}}\n\nCréditos: Hecho por Lournyx Matterssmith [Lou-Nyx].\n",
    "message-frame": "*꒦꒷✰꒷꒦︶꒦꒷✧꒷꒦︶꒦꒷✰꒷꒦*\n{{CLASSIC_HEADER}} {{TITLE}}\n{{BODY}}\n{{CLASSIC_CLOSE}}\n",
    "pong": "{{CLASSIC_HEADER}} 𝐏𝐨𝐧𝐠\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ⴵ · 𝐒𝐨𝐜𝐤𝐞𝐭 ···· *{{SOCKET}} ms*\n{{CLASSIC_ROW}}{{CLASSIC_BRANCH}}[ ⚙︎  𝐏𝐫𝐨𝐜𝐞𝐬𝐬 · *{{PROCESS}} ms*\n{{CLASSIC_ROW}}{{CLASSIC_LAST_BRANCH}}[ ✧  𝐓𝐨𝐭𝐚𝐥 ········ *{{TOTAL}} ms*\n{{CLASSIC_CLOSE}}\n",
    "menu": {
      "all": "{{CLASSIC_EMBLEM}} @AllTitle · @LabelCommands: @Commands\n@AllRows\n",
      "all-category-row": "╞═╦═ @CategoryIcon *@CategoryName*\n@CommandRows\n",
      "category-row": "{{CLASSIC_ROW}}@Branch[ *@CategoryIcon ·· @CategoryName* `[menu @CategoryId]`\n",
